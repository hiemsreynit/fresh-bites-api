            },
            "example": {
              "error": "An unexpected error occurred"
            }
          }
        }
      },
      "ProductBadRequest": {
        "description": "Invalid product data or ObjectId",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Invalid product data or product id"
            }
          }
        }
      },
      "ProductNotFound": {
        "description": "Product not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "Product not found"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque token"
      }
    }
  }
