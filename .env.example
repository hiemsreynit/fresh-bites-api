
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=fresh_bites
MONGO_USERNAME=admin
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin

# Use a hostname or IP only here; put the port in SMTP_PORT.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Use a stable, randomly generated secret with at least 32 bytes.
OTP_HASH_SECRET=

# Presentation payments default to a clearly labeled local demo simulation.
PAYMENT_PROVIDER=demo

# Bakong integration is blocked until an approved server-side KHQR SDK and
# official SIT credentials are available. Production mode is intentionally
# not supported by this application yet.
BAKONG_ENVIRONMENT=sit
BAKONG_API_TOKEN=
BAKONG_MERCHANT_ACCOUNT_ID=
BAKONG_MERCHANT_NAME=
